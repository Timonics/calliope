# --- calliope environment ---
# Copy to .env for local development (`cp .env.example .env`).

# PostgreSQL connection string.
# docker compose up → postgres://postgres:postgres@localhost:5435/calliope
DATABASE_URL=postgres://postgres:postgres@localhost:5435/calliope

# HTTP port the API listens on.
PORT=3002

# Cerberus (auth service) JWKS endpoint — public, no auth required.
CERBERUS_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# Expected `iss` / `aud` claims on cerberus-issued JWTs.
CERBERUS_ISSUER=cerberus
CERBERUS_AUDIENCE=cerberus-clients

# Integration test database. The integration suite (npm run test:integration)
# is skipped unless this is set — point it at a throwaway database only.
# CALLIOPE_TEST_DB=postgres://postgres:postgres@localhost:5435/calliope
