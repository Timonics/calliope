// =============================================================================
// Calliope — Prisma data contract
// =============================================================================
//
// This file is the single source of truth for the persistence shape of the
// blogging domain (v1). Repositories MUST NOT leak Prisma types into the
// domain layer — they map at the boundary.
//
// Conventions used throughout:
//
//   * Primary keys are UUIDs generated by the application layer
//     (`crypto.randomUUID()`), NOT by the database — ids are minted by the
//     service so the domain event / API response can reference them before
//     persistence. Columns are `@db.Uuid`.
//
//   * `createdAt` / `updatedAt` on every model.
//
//   * Multi-tenancy: `Blog.tenantId` carries the cerberus organization UUID
//     (`org` claim). Every blog-scoped model hangs off `blogId`, and
//     slugs are unique per blog (`@@unique([blogId, slug])`).
//
//   * Enum names are PascalCase in Prisma, SCREAMING_SNAKE_CASE values in
//     the database.
//
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Blogging domain
// -----------------------------------------------------------------------------

/// A tenant's blog. `tenantId` is the cerberus organization UUID; one tenant
/// may own several blogs, disambiguated by `slug`.
model Blog {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid /// cerberus organization UUID (the tenant).
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authors    Author[]
  categories Category[]
  tags       Tag[]
  articles   Article[]
  series     Series[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("blogs")
}

/// A named sequence of articles within a blog (multipart / follow-up
/// posts). `total` is NOT stored — it is the count of PUBLISHED articles
/// in the series, computed at read time (see SeriesService / the article
/// projection) so the emitted number is always true.
model Series {
  id        String   @id @db.Uuid
  blogId    String   @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@unique([blogId, slug])
  @@map("series")
}

/// A content author scoped to a single blog.
model Author {
  id        String   @id @db.Uuid
  blogId    String   @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  bio       String?
  avatarUrl String?
  /// Public profile links (`[{ "label", "url" }]`), rendered next to the
  /// author byline. JSON, not a relation — links are display-only.
  links     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@index([blogId])
  @@map("authors")
}

/// Article classification within a blog.
model Category {
  id          String   @id @db.Uuid
  blogId      String   @db.Uuid
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@unique([blogId, slug])
  @@map("categories")
}

/// A client-supplied idempotency key for article creation (the
/// `Idempotency-Key` request header). A replayed (key, blog, endpoint)
/// tuple returns the original article instead of creating a duplicate;
/// entries older than the service-layer retention window (24h) are
/// ignored. Plain strings, not a relation — the article row may outlive
/// its key by design and the key must not constrain article deletion.
model IdempotencyKey {
  id        String   @id @db.Uuid
  key       String
  blogId    String   @db.Uuid
  endpoint  String
  articleId String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([key, blogId, endpoint])
  @@map("idempotency_keys")
}

/// Free-form label within a blog. Implicit many-to-many with Article via
/// the Prisma-generated `_ArticleToTag` join table.
model Tag {
  id        String   @id @db.Uuid
  blogId    String   @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@unique([blogId, slug])
  @@map("tags")
}

/// A content unit. `content` is a JSON block list (structured editor
/// output). `relatedArticleIds` is a Postgres array of article UUIDs —
/// same-blog / self-reference / no-duplicate invariants are enforced in
/// the service layer, NOT by the database.
model Article {
  id                String        @id @db.Uuid
  blogId            String        @db.Uuid
  blog              Blog          @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorId          String        @db.Uuid
  author            Author        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId        String?       @db.Uuid
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title             String
  /// One-line dek, shown under the title.
  subtitle          String?
  slug              String
  /// REQUIRED on publish — 1-sentence takeaway (enforced in the service
  /// layer: `assertPublishable`).
  excerpt           String?
  content           Json
  /// Structured hero image (`{ url, alt, caption?, credit?, width,
  /// height }`). REQUIRED on publish (alt/width/height included).
  /// `coverImageUrl` is the legacy mirror of `coverImage.url`, synced on
  /// write by the service layer.
  coverImage        Json?
  coverImageUrl     String?
  /// Editor-picked homepage hero.
  featured          Boolean       @default(false)
  /// Multipart-post membership. `seriesPosition` is 1-based and REQUIRED
  /// whenever `seriesId` is set (service-layer invariant).
  seriesId          String?       @db.Uuid
  series            Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesPosition    Int?
  readingTimeMinutes Int?
  /// For cross-posts / syndication.
  canonicalUrl      String?
  /// Content locale; `en` unless overridden.
  locale            String        @default("en")
  /// Visible editorial record (`[{ "date", "note" }]`, chronological).
  corrections       Json          @default("[]")
  /// SEO overrides (`{ socialImageUrl?, socialTitle?, socialDescription?,
  /// noIndex? }`); absent keys mean "no override".
  seo               Json          @default("{}")
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  relatedArticleIds String[]      @db.Uuid
  /// Optimistic-locking counter. Incremented on every management
  /// update; a client that passes `If-Match` (or `version`) gets a
  /// 409 `article.conflict` when the row moved underneath them.
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tags Tag[]

  @@unique([blogId, slug])
  @@index([blogId, status])
  @@index([blogId, categoryId])
  @@index([blogId, authorId])
  @@index([seriesId, status])
  @@map("articles")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
